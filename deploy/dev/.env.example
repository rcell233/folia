# Local development only. These credentials bind to loopback ports and must not
# be reused for a shared or production deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

GOTRUE_JWT_SECRET=hello456
GOTRUE_ADMIN_EMAIL=admin@example.com
GOTRUE_ADMIN_PASSWORD=password
GOTRUE_PORT=9999

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

REDIS_PORT=6379
WEB_PORT=3000

# Keep application images on the tested Folia release. Source-run Cloud and Web
# are intentionally absent from this Compose stack.
FOLIA_AUTH_IMAGE=ghcr.io/rcell233/folia-auth:0.1.0
FOLIA_WORKER_IMAGE=ghcr.io/rcell233/folia-worker:0.1.0
