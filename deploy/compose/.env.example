# Change all public URLs together. Use wss:// when the public URL uses HTTPS.
FOLIA_HTTP_PORT=8088
APPFLOWY_HOST=localhost:8088
APPFLOWY_BASE_URL=http://localhost:8088
APPFLOWY_WEBSOCKET_BASE_URL=ws://localhost:8088/ws/v2

# Generated by scripts/init-env.sh. Do not reuse these example values.
POSTGRES_USER=appflowy
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=appflowy
GOTRUE_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
GOTRUE_ADMIN_EMAIL=admin@home.local
GOTRUE_ADMIN_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=appflowy
MINIO_ROOT_PASSWORD=CHANGE_ME

# One release tag always identifies a tested Cloud/Web/Auth combination.
FOLIA_CLOUD_IMAGE=ghcr.io/rcell233/folia-cloud:0.1.2
FOLIA_WEB_IMAGE=ghcr.io/rcell233/folia-web:0.1.2
FOLIA_WORKER_IMAGE=ghcr.io/rcell233/folia-worker:0.1.2
FOLIA_AUTH_IMAGE=ghcr.io/rcell233/folia-auth:0.1.2
FOLIA_URL_MIGRATOR_IMAGE=ghcr.io/rcell233/folia-url-migrator:0.1.2

# Optional SMTP. Use an app-specific password, not the mailbox login password.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=sender@example.com
SMTP_PASS=CHANGE_ME
SMTP_SENDER_NAME="Folia"
